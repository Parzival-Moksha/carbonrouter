# ═══════════════════════════════════════════════════
# CARBONROUTER · v0.0.4 · DROP YOUR KEYS HERE
# ═══════════════════════════════════════════════════
# Copy this to .env and fill in your values.

# ── Embedding API ─────────────────────────────────
# Pick ONE: OpenRouter (recommended) or OpenAI direct.
#
# OpenRouter — proxies OpenAI, Cohere, and more:
OPENROUTER_API_KEY=
#
# Or OpenAI directly:
# OPENAI_API_KEY=
#
# Model override (defaults below are good):
# EMBEDDING_MODEL=openai/text-embedding-3-small   (for OpenRouter)
# EMBEDDING_MODEL=text-embedding-3-small           (for OpenAI direct)
# EMBEDDING_DIMENSIONS=1536

# ── PostgreSQL ────────────────────────────────────
# Needs pgvector extension. Install: CREATE EXTENSION vector;
DATABASE_URL=postgresql://user:password@localhost:5432/carbonrouter

# ── Server ────────────────────────────────────────
# PORT=3001
